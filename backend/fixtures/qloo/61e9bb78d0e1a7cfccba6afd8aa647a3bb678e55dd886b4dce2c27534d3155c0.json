{"results": [{"name": "Trader Joe's", "entity_id": "096B986E-3D63-44F4-BE44-F85D52A2979D", "types": ["urn:entity:brand"], "properties": {"akas": [], "description": "A beloved grocery store chain that emphasizes a unique, curated selection of high-quality food and beverages, primarily under its own private label. Founded in 1967, the company differentiates itself from traditional supermarkets through a compact store footprint, friendly neighborhood atmosphere, and a rotating inventory of innovative, affordable products. It appeals to a wide demographic of shoppers who seek convenience without compromising on quality or excitement in their daily culinary choices. The brand has built a cult-like following due to its consistently good value proposition and a shopping experience that prioritizes discovery and customer engagement.", "external": {"instagram": {"id": "traderjoes"}}, "founded_year": "1967", "image": {"url": "https://images.qloo.com/i/096B986E-3D63-44F4-BE44-F85D52A2979D-420x-auto.jpg"}, "short_description": "Trader Joe's is a neighborhood grocery store chain known for its unique, high-quality food and drink products at everyday low prices.", "short_descriptions": [{"language": "de", "value": "Eine Supermarktkette mit ausgewählten, einzigartigen Lebensmitteln und Getränken von hoher Qualität zu erschwinglichen Preisen."}, {"language": "en", "value": "A neighborhood grocery chain offering a curated selection of unique, high-quality food and beverage products at accessible prices."}, {"language": "es", "value": "Una cadena de supermercados de barrio que ofrece una selección curada de productos de alimentación únicos y de alta calidad a precios asequibles."}, {"language": "fr", "value": "Une chaîne d'épiceries de quartier proposant une sélection unique de produits alimentaires de haute qualité à des prix accessibles."}]}, "popularity": 0.9844128765404893, "disambiguation": "", "tags": [{"name": "Retail", "tag_id": "urn:tag:genre:brand:retail", "type": "urn:tag:g