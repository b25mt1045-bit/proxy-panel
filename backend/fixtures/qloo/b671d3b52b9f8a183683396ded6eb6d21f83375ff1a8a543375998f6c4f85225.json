{"results": [{"name": "Spindrift Sparkling Water", "entity_id": "AB20E24F-7B08-4215-BA29-ED341192FE3F", "types": ["urn:entity:brand"], "properties": {"akas": [], "description": "Spindrift is a pioneering beverage brand that redefined the sparkling water category by using real squeezed fruit instead of natural essences or artificial flavors. Founded on the principle that the best tastes come from nature, the company meticulously sources fruit to provide a cleaner, more authentic drinking experience. Their product range, which now includes sparkling teas, appeals to a health-conscious audience seeking to avoid sugar and synthetic ingredients without compromising on flavor. The brand maintains a strong market position as a premium, transparent alternative to traditional soda and flavored seltzer brands.", "external": {"instagram": {"id": "drinkspindrift"}}, "founded_year": "2010", "image": {"url": "https://images.qloo.com/i/AB20E24F-7B08-4215-BA29-ED341192FE3F-420x-auto.jpg"}, "short_description": "Spindrift Sparkling Water is a beverage brand known for sparkling water made with real squeezed fruit, offering natural flavors without added sugars or artificial ingredients.", "short_descriptions": [{"language": "fr", "value": "Une marque d'eau pétillante qui se distingue par l'utilisation de vrais fruits pressés, sans sucres ajoutés ni ingrédients artificiels, pour un goût naturellement authentique."}, {"language": "de", "value": "Eine Marke für Sprudelwasser, die sich durch die Verwendung von echtem Fruchtsaft ohne Zuckerzusatz oder künstliche Inhaltsstoffe für einen natürlich lebendigen Geschmack auszeichnet."}, {"language": "en", "value": "A sparkling water brand distinguished by using only real squeezed fruit and no added sugars or artificial ingredients for a naturally vibrant taste."}, {"language": "es", "value": "Una marca de agua con gas que destaca por utilizar únicamente fruta exprimida real y sin azúcares añadidos ni ingredientes artificiales, ofreciendo un sabor natural y auténtico."}]}, "popularity": 0.7946974962282382, "disambiguation": "", "tags": [{"name": "Drinks", "tag_id": "urn:tag:genre:brand:food_and_beverage:drinks", "type": "urn:tag:genre:brand"}, {"name": "Carbonated", "tag_id": "urn:tag:genre:brand:food_and_beverage:drinks:carbonated", "type": "urn:tag:genre:brand"}, {"name": "Food & Beverage", "tag_id": "urn:tag:genre:brand:food_and_beverage", "type": "urn:tag:genre:brand"}, {"name": "Minimalist", "tag_id": "urn:tag:aesthetic_property:qloo:minimalist", "type": "urn:tag:aesthetic_property:qloo"}, {"name": "Bright", "tag_id": "urn:tag:aesthetic_property:qloo:bright", "type": "urn:tag:aesthetic_property:qloo"}, {"name": "Fresh", "tag_id": "urn:tag:aesthetic_property:qloo:fresh", "type": "urn:tag:aesthetic_property:qloo"}, {"name": "Fruit-Focused Imagery", "tag_id": "urn:tag:aesthetic_property:qloo:fruit_focused_imagery", "type": "urn:tag:aesthetic_property:qloo"}, {"name": "Mindful Consumption", "tag_id": "urn:tag:lifestyle:qloo:mindful_consumption", "type": "urn:tag:lifestyle:qloo"}, {"name": "Outdoor Exploration", "tag_id": "urn:tag:lifestyle:qloo:outdoor_exploration", "type": "urn:tag:lifestyle:qloo"}, {"name": "Clean Eating", "tag_id": "urn:tag:lifestyle:qloo:clean_eating", "type": "urn:tag:lifestyle:qloo"}, {"name": "CPG", "tag_id": "urn:tag:brand_subtype:qloo:cpg", "type": "urn:tag:brand_subtype:qloo"}, {"name": "Product Brand", "tag_id": "urn:tag:brand_type:qloo:product_brand", "type": "urn:tag:brand_type:qloo"}, {"name": "B2C", "tag_id": "urn:tag:business_model:qloo:b2c", "type": "urn:tag:business_model:qloo"}, {"name": "LaCroix", "tag_id": "urn:tag:competitor_brand:qloo:lacroix", "type": "urn:tag:competitor_brand:qloo"}, {"name": "Bubly", "tag_id": "urn:tag:competitor_brand:qloo:bubly", "type": "urn:tag:competitor_brand:qloo"}, {"name": "Polar Seltzer", "tag_id": "urn:tag:competitor_brand:qloo:polar_seltzer", "type": "urn:tag:competitor_brand:qloo"}, {"name": "Waterloo Sparkling Water", "tag_id": "urn