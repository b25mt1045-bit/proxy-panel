{"results": [{"name": "Headspace", "entity_id": "54D2569F-A0F1-41A3-8C83-F0E2155C3EDB", "types": ["urn:entity:brand"], "properties": {"akas": [{"language": "de", "value": "Headspace Inc."}, {"language": "en_au", "value": "Headspace Inc."}, {"language": "fr", "value": "Headspace Inc."}, {"language": "hu", "value": "Headspace"}], "description": "Headspace is a global digital health platform founded in 2010 with the mission of making mental health support accessible to everyone. The company provides a comprehensive suite of tools, ranging from self-guided meditation and sleep content to clinical therapy and psychiatry services. Through its subscription-based app and enterprise solutions, it serves both individual consumers and organizations, integrating mental health resources into everyday life. The brand is recognized for its approachable aesthetic and evidence-based approach to fostering resilience and reducing stress.", "external": {"facebook": {"id": "Headspace"}, "instagram": {"id": "headspaceaz"}, "twitter": {"id": "Headspace"}, "wikidata": {"id": "Q3079832"}}, "founded_year": "2010", "headquartered": "Los Angeles", "image": {"url": "https://images.qloo.com/i/54D2569F-A0F1-41A3-8C83-F0E2155C3EDB-420x-auto.jpg"}, "inception": "2010-01-01", "industry": ["health care industry"], "official_site": "https://www.headspace.com/", "products": [], "short_description": "Headspace is a digital health brand offering meditation, mindfulness, sleep aids, mental health coaching, and therapy services through an app and online platform.", "short_descriptions": [{"language": "de", "value": "Eine digitale Plattform für psychische Gesundheit, die geführte Meditation, Achtsamkeitstools, Schlafhilfen und professionelle klinische Unterstützung für das tägliche Wohlbefinden bietet."}, {"language": "es", "value": "Una plataforma digital de salud mental que ofrece meditación guiada, herramientas de atención plena, recursos para el sueño y atención clínica profesional para el bienestar dia