: ["urn:entity:brand"], "properties": {"akas": [], "description": "Each x Other is a Paris-based fashion house that functions as a creative collective, bridging the worlds of art, film, poetry, and clothing. Known for its distinctively sharp tailoring and collaborative design approach, the brand integrates works by artists and creators directly into its seasonal collections. It appeals to a sophisticated, creatively-driven demographic that values artistic expression and high-quality construction. Operating as a contemporary label, it maintains a unique niche by positioning every collection as a cross-disciplinary project rather than a standard commercial release.", "external": {"instagram": {"id": "eachxother"}}, "founded_year": "2012", "image": {"url": "https://images.qloo.com/i/49E0DBE0-FCEF-4DA9-A692-A25FE1B2E5A6-420x-auto.jpg"}, "short_description": "Each x Other is a collaborative fashion brand blending art, music, poetry, film, and fashion design, known for unique apparel like blazers and knitwear.", "short_descriptions": [{"language": "fr", "value": "Une maison de mode collaborative qui fusionne art, musique et poésie pour créer des pièces de prêt-à-porter uniques."}, {"language": "de", "value": "Ein kollaboratives Modehaus, das Kunst, Musik und Poesie vereint, um einzigartige Prêt-à-porter-Stücke zu entwerfen."}, {"language": "en", "value": "A collaborative fashion house that blends art, music, and poetry to create unique, ready-to-wear pieces."}, {"language": "es", "value": "Una casa de moda colaborativa que fusiona el arte, la música y la poesía para crear piezas únicas de prêt-à-porter."}]}, "popularity": 0.7059805733077927, "disambiguation": "", "tags": [{"name": "Fashion", "tag_id": "urn:tag:genre:brand:fashion", "type": "urn:tag:genre:brand"}, {"name": "Casual", "tag_id": "urn:tag:genre:brand:fashion:casual", "type": "urn:tag:genre:brand"}, {"name": "Minimalist Silhouettes", "tag_id": "urn:tag:aesthetic_property:qloo:minimalist_silhouettes", "type": "u